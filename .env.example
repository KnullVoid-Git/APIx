# Convex Cloud Deployment URL (Optional: Run `npx convex dev` to initialize)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Global Serverless Rate Limiter (Vercel KV or Upstash Redis - 60 req/min per IP)
# Automatically populated when adding Vercel KV / Upstash integration in Vercel Dashboard
KV_REST_API_URL=https://your-kv-db.upstash.io
KV_REST_API_TOKEN=your-kv-rest-token
# Or alternatively:
# UPSTASH_REDIS_REST_URL=https://your-redis-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

